      "name": "supervise__report_progress",
      "description": "Attach host evidence to one criterion in the selected session-scoped supervision contract and optionally claim the exact current plan step for watchdog review.",
      "class": "StateMutating",
      "application_worker": {"plan_visible": true},
      "schema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"idempotency_key\",\"anchor\",\"criterion_index\",\"evidence_refs\"],\"properties\":{\"idempotency_key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9._:-]+$\"},\"anchor\":{\"$ref\":\"#/$defs/anchor\"},\"criterion_index\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":63},\"evidence_refs\":{\"$ref\":\"#/$defs/evidence_refs\"},\"complete_active_step\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256}},\"$defs\":{\"anchor\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"session_sequence\",\"plan_version\",\"active_step\",\"tree_digest\",\"turn_ref\"],\"properties\":{\"session_sequence\":{\"type\":\"integer\",\"minimum\":1},\"plan_version\":{\"type\":\"integer\",\"minimum\":1},\"active_step\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"tree_digest\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":512},\"turn_ref\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":512}}},\"evidence_refs\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":32,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1024}}}}"
    },
    {
