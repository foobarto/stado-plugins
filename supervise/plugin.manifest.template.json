      "class": "StateMutating",
      "application_worker": {"plan_visible": true},
      "schema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"idempotency_key\",\"anchor\",\"rationale\",\"replacement\"],\"properties\":{\"idempotency_key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9._:-]+$\"},\"anchor\":{\"$ref\":\"#/$defs/anchor\"},\"rationale\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"replacement\":{\"$ref\":\"#/$defs/baseline\"}},\"$defs\":{\"anchor\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"session_sequence\",\"plan_version\",\"active_step\",\"tree_digest\",\"turn_ref\"],\"properties\":{\"session_sequence\":{\"type\":\"integer\",\"minimum\":1},\"plan_version\":{\"type\":\"integer\",\"minimum\":1},\"active_step\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"tree_digest\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":512},\"turn_ref\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":512}}},\"baseline\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"objective\",\"acceptance_criteria\",\"plan\",\"definition_of_done\",\"verification\"],\"properties\":{\"objective\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"constraints\":{\"$ref\":\"#/$defs/bounded_list\"},\"non_goals\":{\"$ref\":\"#/$defs/bounded_list\"},\"acceptance_criteria\":{\"$ref\":\"#/$defs/required_list\"},\"plan\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":64,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"title\",\"done_when\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64},\"title\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1024},\"done_when\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096}}}},\"definition_of_done\":{\"$ref\":\"#/$defs/required_list\"},\"verification\":{\"$ref\":\"#/$defs/required_list\"},\"risks\":{\"$ref\":\"#/$defs/bounded_list\"}}},\"bounded_list\":{\"type\":\"array\",\"maxItems\":64,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096}},\"required_list\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":64,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096}}}}"
    },
    {
      "name": "supervise__request_completion",
      "description": "Submit criterion-linked host evidence for a watchdog-reviewed completion candidate at the exact current supervision anchor.",
      "class": "StateMutating",
      "application_worker": {"plan_visible": true},
      "schema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"idempotency_key\",\"anchor\",\"criteria\"],\"properties\":{\"idempotency_key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9._:-]+$\"},\"anchor\":{\"$ref\":\"#/$defs/anchor\"},\"criteria\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":64,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"criterion_index\",\"evidence_refs\"],\"properties\":{\"criterion_index\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":63},\"evidence_refs\":{\"$ref\":\"#/$defs/evidence_refs\"}}}}},\"$defs\":{\"anchor\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"session_sequence\",\"plan_version\",\"active_step\",\"tree_digest\",\"turn_ref\"],\"properties\":{\"session_sequence\":{\"type\":\"integer\",\"minimum\":1},\"plan_version\":{\"type\":\"integer\",\"minimum\":1},\"active_step\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":256},\"tree_digest\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":512},\"turn_ref\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":512}}},\"evidence_refs\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":32,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1024}}}}"
    }
